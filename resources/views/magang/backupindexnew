<script>
function validateForm() {
    // Ambil semua radio button dengan name yang sama
    const radios = document.getElementsByName('flexRadioDefault');
    let formValid = false;

    // Cek apakah ada yang dipilih
    for (let i = 0; i < radios.length; i++) {
        if (radios[i].checked) {
            formValid = true;
            break;
        }
    }



    // Jika memilih radio dengan id "tidakpilihradio"
    const tidakSetuju = document.getElementById('tidakpilihradio');
    if (tidakSetuju.checked) {
        alert("Mohon pilih salah satu opsi persetujuan terlebih dahulu.");
        return false;
    }

    // Kalau memilih 'Setuju', form lanjut dikirim
    return true;
}
</script>


