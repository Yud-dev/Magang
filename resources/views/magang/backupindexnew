<script>
    const route = "{{ route('autocompleteJurusan') }}";

    $(function () {
        $("#search").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: route,
                    type: 'GET',
                    dataType: 'json',
                    data: { search: request.term },
                    success: function (dataJurusan) {
                        response(dataJurusan);
                    }
                });
            },

            select: function (event, ui) {
                // Jika data tidak ditemukan (id = null)
                if (ui.item.id === null) {
                    $('#search').val(""); // kosongkan input
                    return false;
                }

                // Jika data ditemukan
                $('#search').val(ui.item.value);
                return false;
            },

            focus: function (event, ui) {
                // Mencegah ganti value saat hover
                return false;
            },

            minLength: 1
        });
    });
</script>

