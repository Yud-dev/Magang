<!-- ===== MODAL TOLAK ===== -->
<div class="modal fade" id="modalTolak" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Alasan Penolakan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form id="formTolak">
                <div class="modal-body">
                    <textarea id="inputAlasan" class="form-control"
                        placeholder="Masukkan alasan penolakan..." rows="4"></textarea>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="button" id="btnConfirmTolak" class="btn btn-danger-gradient">Tolak & Pilih Status</button>
                </div>
            </form>

        </div>
    </div>
</div>

<script>
// === TOMBOL DITERIMA ===
document.getElementById("btnDiterima").addEventListener("click", function() {
    document.getElementById("statusValue").value = "disetujui";
    document.getElementById("btnSubmit").disabled = false;

    alert("Status dipilih: DITERIMA");
});

// === KONFIRMASI TOLAK ===
document.getElementById("btnConfirmTolak").addEventListener("click", function() {
    let alasan = document.getElementById("inputAlasan").value;

    if (alasan.trim() === "") {
        alert("Alasan penolakan wajib diisi!");
        return;
    }

    document.getElementById("statusValue").value = "ditolak";

    // tambahkan input hidden alasan ke form utama
    let formMain = document.querySelector("form");
    let inputHidden = document.createElement("input");
    inputHidden.type = "hidden";
    inputHidden.name = "alasan_penolakan";
    inputHidden.value = alasan;
    formMain.appendChild(inputHidden);

    document.getElementById("btnSubmit").disabled = false;

    document.querySelector("#modalTolak .btn-close").click();

    alert("Status dipilih: DITOLAK");
});
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
